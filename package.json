{
  "name": "paper-home",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:prepare": "node scripts/assets.mjs",
    "assets:1k": "node scripts/assets-1k.mjs",
    "assets:verify": "node scripts/check-assets.mjs",
    "prebuild": "node scripts/check-assets.mjs",
    "check:camera": "node scripts/camera-check.mjs",
    "check:polish": "node scripts/polish-check.mjs",
    "check:window-performance": "node scripts/window-performance.mjs after",
    "check:interactions": "node scripts/verify.mjs",
    "check:edge-cases": "node scripts/edge-cases.mjs",
    "check:cms": "node scripts/cms-verify.mjs",
    "check:local": "node scripts/local-verify.mjs",
    "check:phase1": "node scripts/phase1-verify.mjs",
    "check:phase2": "node scripts/phase2-verify.mjs",
    "check:sound": "node scripts/sound-verify.mjs",
    "qa:report": "node scripts/polish-report.mjs",
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "studio": "vite --host 127.0.0.1 --port 4318 --strictPort --open",
    "init:sample": "node scripts/init-sample.mjs",
    "build": "tsc -b && vite build",
    "build:local": "node scripts/check-assets.mjs && tsc -b && vite build --mode local-export",
    "promo:capture": "node scripts/promo-capture.mjs",
    "sync:supabase": "node scripts/sync-supabase.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "export:public": "node scripts/export-public.mjs",
    "check:regressions": "node scripts/check-regressions.mjs",
    "check:config": "tsc --noEmit -p tsconfig.config.json",
    "check:edge": "node scripts/edge-typecheck.mjs",
    "check:supabase": "node scripts/supabase-integration.mjs",
    "check:ci": "node scripts/ci-verify.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "gsap": "^3.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.0",
    "meshoptimizer": "^1.3.0",
    "pg": "8.23.1",
    "sharp": "^0.35.5",
    "supabase": "3.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
